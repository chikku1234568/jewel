# Copy to .env and fill in. Never commit .env. Secrets are empty on purpose.

# --- Google sign-in (identity scopes only: openid, email, profile) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local development uses a localhost redirect URI, e.g.
# GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
GOOGLE_REDIRECT_URI=

# --- Sessions and API-key encryption (generate long random values) ---
SESSION_SECRET=
KEY_ENCRYPTION_SECRET=

# --- Postgres (accounts, sessions, documents, ciphertext keys, chunks) ---
POSTGRES_USER=jewel
POSTGRES_PASSWORD=jewel
POSTGRES_DB=jewel
DATABASE_URL=postgresql://jewel:jewel@localhost:5432/jewel

# --- Neo4j 5.x Community (per-user knowledge graph) ---
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-please
NEO4J_URI=bolt://localhost:7687

# --- Models (xAI, OpenAI-compatible, base URL fixed at https://api.x.ai/v1) ---
# Each user brings their own xAI key through the app; there is no project key here.
# Choose ids from the current docs at https://docs.x.ai when implementing.
JEWEL_LLM_MODEL=
JEWEL_EMBEDDING_MODEL=

# --- App ---
JEWEL_ENV=local
JEWEL_UPLOAD_DIR=./data/uploads
VITE_API_BASE_URL=http://localhost:8000
