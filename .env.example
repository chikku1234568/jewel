# Copy to .env and adjust. Never commit .env.
# All values are placeholders; the LLM provider is not chosen yet (see docs/open-questions.md).

# --- Neo4j 5.x Community (graph store + vector index) ---
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-please
JEWEL_NEO4J_URI=bolt://localhost:7687
JEWEL_NEO4J_USER=neo4j
JEWEL_NEO4J_PASSWORD=change-me-please

# --- Redis (cache) ---
JEWEL_REDIS_URL=redis://localhost:6379/0

# --- LLM / embeddings (provider-agnostic; TBD) ---
JEWEL_LLM_PROVIDER=unset
JEWEL_LLM_MODEL=unset
JEWEL_EMBEDDING_MODEL=unset
# Provider API key variable name depends on the chosen provider, e.g. <PROVIDER>_API_KEY=

# --- App ---
JEWEL_ENV=local
VITE_API_BASE_URL=http://localhost:8000
