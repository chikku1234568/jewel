# Copy to infra/prod.env on the VM. chmod 600. Do not commit prod.env.
# Passwords here must be URL-safe (letters and digits). They are placed into DATABASE_URL as-is.
# Command, from the repo root:
#   docker compose -f infra/docker-compose.prod.yml --env-file infra/prod.env up -d --build

SITE_ADDRESS=tryjewel.dev
ACME_EMAIL=

POSTGRES_USER=jewel
POSTGRES_PASSWORD=
POSTGRES_DB=jewel

NEO4J_USER=neo4j
NEO4J_PASSWORD=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://tryjewel.dev/api/auth/google/callback
JEWEL_FRONTEND_URL=https://tryjewel.dev
SESSION_SECRET=
