%% name: 11-concurrency
%% keep: hand
%% Where work piles up. Jewel does not count requests per person or per minute.
flowchart TB
    browser[Browser]

    subgraph edge [Caddy]
        body[Reject a body over 20 MB]
        hold[Keep the proxy open<br/>for up to 15 minutes]
    end

    subgraph process [One API process]
        pool["Sync routes share one pool<br/>of 40 threads"]
        up["Upload runs inside the request.<br/>The page sends files one by one."]
        ask["Ask holds one thread<br/>until the model finishes"]
        start["Build starts a daemon thread<br/>and returns"]
        lock["One lock for the whole VM.<br/>One file is extracted at a time."]
        eight["Inside that file,<br/>8 passage calls at once"]
    end

    subgraph provider ["The visitor's model host"]
        modelCall["Each call waits at most 120 seconds"]
        retry["HTTP 429: up to 5 waits,<br/>never longer than 30 seconds each.<br/>Connection errors: 3 tries."]
    end

    subgraph memory [Memory on the 8 GB VM]
        copy["Each Ask keeps a copy<br/>of that user's graph"]
        neo["Neo4j will not grow past<br/>1 GB heap and 1 GB page cache"]
    end

    browser --> body --> hold --> pool
    pool --> up
    pool --> ask
    pool --> start --> lock --> eight
    ask --> modelCall
    eight --> modelCall
    modelCall --> retry
    ask --> copy
    lock --> neo
