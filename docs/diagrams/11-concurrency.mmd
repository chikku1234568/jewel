%% name: 11-concurrency
%% keep: hand
%% Where work piles up. Two files can extract at once. Each account has an hourly cap.
flowchart TB
    browser[Browser]

    subgraph edge [Caddy]
        body[Reject a body over 20 MB]
        hold[Keep the proxy open<br/>for up to 15 minutes]
    end

    subgraph process [One API process]
        pool["Sync routes share one pool<br/>of 40 threads"]
        up["Upload runs inside the request.<br/>The page sends files one by one.<br/>30 uploads an hour per account"]
        ask["Ask holds one thread<br/>until the model finishes<br/>60 questions an hour per account"]
        start["Build records waiting and returns.<br/>20 builds an hour per account"]
        slots["Postgres starts a file when a slot is free.<br/>At most two extracting.<br/>At most one of those per account."]
        eight["Each extracting file<br/>makes 8 passage calls at once"]
        restart["A restart marks an unfinished build failed.<br/>The key is not stored. Build again."]
    end

    subgraph provider ["The visitor's model host"]
        modelCall["Each call waits at most 120 seconds"]
        retry["HTTP 429: up to 5 waits,<br/>never longer than 30 seconds each.<br/>Connection errors: 3 tries."]
    end

    subgraph memory [Memory on the 8 GB VM]
        copy["Each Ask keeps a copy<br/>of that user's graph"]
        neo["Neo4j will not grow past<br/>1 GB heap and 1 GB page cache"]
    end

    browser --> body --> hold --> pool
    pool --> up
    pool --> ask
    pool --> start --> slots --> eight
    slots -.-> restart
    ask --> modelCall
    eight --> modelCall
    modelCall --> retry
    ask --> copy
    slots --> neo
